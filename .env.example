# ============================================================================
# OnTime environment configuration
# ============================================================================
# Loaded at server startup by src/server/env.ts (dotenv) BEFORE any module
# reads process.env — it must stay the first import of server.ts and
# src/server/init-db.ts. Variables already present in the process environment
# (shell, CI, orchestrator) take precedence over values in this file.
#
# This file must never contain real credentials. It is the only env file that
# is committed (.gitignore ignores every other .env*).
# ============================================================================

# --- DATABASE_URL -----------------------------------------------------------
# PostgreSQL connection string; PostgreSQL is the authoritative persistent
# store. Apply the schema with `npm run db:init` (or start the server, which
# runs the same migrations automatically).
# Leave unset ONLY for local development: the server then starts in an explicit
# in-memory mode (data is lost on restart) and prints a loud fallback warning.
# Required when NODE_ENV=production — the server refuses to start without it.
# Recognized extras: `sslmode=disable|require|verify-ca|verify-full` is honored
# by node-postgres; hosts other than localhost default to TLS.
DATABASE_URL="postgres://user:password@127.0.0.1:5432/ontime"

# --- JWT_SECRET -------------------------------------------------------------
# HMAC secret for access tokens (7-day lifetime). Required in production: the
# server exits at startup when NODE_ENV=production and this is unset or left at
# the placeholder. In development a random per-process secret is generated when
# unset (sessions are then invalidated on every restart).
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# --- OSRM_URL ---------------------------------------------------------------
# OpenStreetMap OSRM routing endpoint used for road routes and ETA
# (src/server/routing.ts). Defaults to the public demo service when unset —
# run your own OSRM instance for production traffic.
OSRM_URL="https://router.project-osrm.org"

# --- NODE_ENV ---------------------------------------------------------------
# `production` enables: strict auth (no demo bypass), CORS origin allow-list,
# static dist/ serving, and fatal startup on missing JWT_SECRET/DATABASE_URL.
# Any other value (or unset) selects development behavior, including the Vite
# middleware dev server.
NODE_ENV="development"

# --- DEMO_MODE --------------------------------------------------------------
# `true` enables /api/auth/demo-login, relaxes several auth/telemetry checks,
# and permits the in-memory database fallback. Never set this in production.
DEMO_MODE=""

# --- CORS / URLs ------------------------------------------------------------
# Allowed browser origins for the HTTP API and Socket.IO (comma-separated
# lists). Used together with APP_URL; in production requests from other origins
# are rejected. Development allows any origin regardless of these values.
FRONTEND_URL=""
SOCKET_ORIGIN=""
# Public URL of this app (self-referential links and the CORS allow-list).
APP_URL=""

# --- GPS freshness thresholds (seconds) -------------------------------------
# Used by GET /api/public/tracking/:token to classify the driver's last ping.
#   GPS_STALE_AFTER  -> older than this is STALE   (default 30)
#   GPS_OFFLINE_AFTER -> older than this is OFFLINE / LOCATION_UNAVAILABLE
#                        (default 120)
GPS_STALE_AFTER="30"
GPS_OFFLINE_AFTER="120"

# --- Development tooling ----------------------------------------------------
# `true` disables Vite HMR and file watching during development (used by AI
# IDE environments to avoid reload flicker). Read by vite.config.ts only.
DISABLE_HMR="false"
